yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# 环境变量与密钥（务必禁止入库；仅允许示例文件）
.env
.env.*
!.env.example

