*.sln
*.sw?

# Local deploy artifacts
_edgeprofile/
_shots/
pocketbase/pb_data/
pocketbase/logs/

# Night run（备份与大文件不入库，轮报/账本/基线入库留痕）
.nightrun/backup/
.nightrun/evidence/*.tmp
.nightrun/seed/*.tmp

# 诊断与 QA 产物（体积大、可再生，不入库）
.diag/
_qa/
pb_data_backup_*/
# 专项轮 D 素材选取器的输出（每轮重新生成，含 3MB vault 索引，不入库）
_eval/
