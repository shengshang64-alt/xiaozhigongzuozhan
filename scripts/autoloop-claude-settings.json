{
  "_comment": "自主迭代驱动器专用：Claude Code 权限配置（由 scripts/autoloop.mjs --settings 传入）。放在文件里而不是 --allowedTools 命令行，是因为驱动器用 spawn(shell:true) 派生进程（沙箱约束：spawnSync 会 EBUSY），而 cmd.exe 会把 `Bash(git status:*)` 里的括号当成元字符吞掉，导致 claude 以 exit=1 在 0.1s 内退出。",
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "TodoWrite",
      "WebSearch",
      "WebFetch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout --:*)",
      "Bash(git stash:*)",
      "Bash(git restore --:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vite:*)",
      "Bash(npx vitest:*)",
      "Bash(npx eslint:*)",
      "Bash(npx vite-node:*)",
      "Bash(npx prettier:*)",
      "Bash(node:*)",
      "Bash(npm run:*)",
      "Bash(npm ls:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm verify:*)",
      "Bash(ls:*)",
      "Bash(dir:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(mkdir:*)",
      "Bash(echo:*)",
      "Bash(cd:*)",
      "Bash(printf:*)",
      "Bash(Test-Path:*)",
      "Bash(Get-Content:*)",
      "Bash(Get-ChildItem:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout -f:*)",
      "Bash(git checkout .:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf pocketbase/pb_data:*)",
      "Bash(del pocketbase\\pb_data:*)",
      "Read(./.env*)",
      "Read(./**/.env*)",
      "Edit(./.env*)",
      "Edit(./pocketbase/pb_data/**)",
      "Edit(./.qoder/**)"
    ]
  }
}
