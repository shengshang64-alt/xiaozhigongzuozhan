// ---------------------------------------------------------------------------
// ReadingView —— 标书检查三栏阅读界面（R262 阶段2）。
//
// 左 w-64 章节导航（问题徽标 + 滚动联动高亮 + 键盘跳转）
// 中 flex-1 A4 版心只读正文（问题段落红/黄底 + 左侧竖条 + 角标；表格折叠；图片占位；只看有问题）
// 右 w-80 问题清单（按级别/命中分组 + 点击定位闪烁 + 标记已改）
//
// ⚠️ 只标不改：正文纯只读，「标记已改」仅本机 UI 认知态（不写回文件、不改正文）。
// 交付三条设计决策：D-1 中栏只显示文字不渲染图片；D-2 已检出问题必须在正文显示位置标记；D-3 不做目录气泡（用左栏树 + 滚动联动补偿）。
// ---------------------------------------------------------------------------

import { useCallback, useEffect, useMemo, useRef, useState } from "react"
import type { KeyboardEvent as ReactKeyboardEvent, MutableRefObject } from "react"
import {
  Table2,
  FileCode2,
  Image as ImageIcon,
  CheckCircle2,
  ShieldAlert,
  ListChecks,
  PanelLeft,
  ChevronDown,
  ChevronRight,
  Eye,
  EyeOff,
} from "lucide-react"
import { cn } from "@/lib/utils"
import { Button } from "@/components/ui/button"
import { Badge } from "@/components/ui/badge"
import {
  SEVERITY_LABEL,
  type BidCheckResult,
  type CheckHit,
  type CheckItem,
  type Severity,
} from "./bidCheckTypes"
import { estimatePages } from "./engine/docxInspect"

// ---- 派生模型 -------------------------------------------------------------

type Marker = { code: string; severity: Severity; itemTitle: string; key: string }

type Block =
  | { t: "para"; pi: number }
  | { t: "table"; ti: number; pis: number[] }

const SEV_RANK: Record<Severity, number> = { critical: 0, high: 1, medium: 2, info: 3 }

/** 严重度 → 段落底色 + 左侧竖条（标记不遮挡正文：只加底色与竖条，不弹窗） */
const SEV_BG: Record<Severity, string> = {
  critical: "bg-red-50 border-l-[3px] border-l-red-500",
  high: "bg-amber-50 border-l-[3px] border-l-orange-400",
  medium: "bg-yellow-50 border-l-[3px] border-l-amber-400",
  info: "bg-sky-50 border-l-[3px] border-l-sky-300",
}

/** 角标文案与配色（critical 必改 / high·medium 建议 / info 提示） */
const SEV_BADGE: Record<Severity, { label: string; cls: string }> = {
  critical: { label: "必改", cls: "bg-red-500 text-white" },
  high: { label: "建议", cls: "bg-orange-400 text-white" },
  medium: { label: "建议", cls: "bg-amber-500 text-white" },
  info: { label: "提示", cls: "bg-sky-300 text-sky-950" },
}

/** 标题层级：按点号编号深度 / 「第X章」降一级，封顶 4 级（近似 Word 层级字号） */
function headingLevel(text: string): number {
  const m = /^(\d+(?:\.\d+)*)\s/.exec(text.trim())
  if (m) return Math.min(4, m[1].split(".").length)
  if (/^第[一二三四五六七八九十百0-9]+[章节篇部分]/.test(text.trim())) return 1
  return 2
}

const HEADING_CLS: Record<number, string> = {
  1: "text-lg font-bold mt-4 mb-2",
  2: "text-base font-semibold mt-3 mb-1.5",
  3: "text-sm font-semibold mt-2.5 mb-1",
  4: "text-sm font-medium mt-2 mb-1",
}

function hitKey(code: string, hit: CheckHit, i: number): string {
  return hit.paragraphIndex != null ? `${code}#${hit.paragraphIndex}` : `${code}@${i}`
}

// ---- 组件 -----------------------------------------------------------------

type Props = {
  result: BidCheckResult
  blocked: boolean
  hardFatal: boolean
  onExportExcel: () => void
  onExportHtml: () => void
}

export function ReadingView({ result, blocked, hardFatal, onExportExcel, onExportHtml }: Props) {
  const paras = result.paragraphs
  const chapters = result.chapters
  const chapterOf = result.chapterOf

  const [onlyIssues, setOnlyIssues] = useState(false)
  const [sevFilter, setSevFilter] = useState<Severity | "all">("all")
  const [activeChapter, setActiveChapter] = useState(0)
  const [focusPara, setFocusPara] = useState<number | null>(null)
  const [flashPara, setFlashPara] = useState<number | null>(null)
  const [hoverPara, setHoverPara] = useState<number | null>(null)
  const [selectedKey, setSelectedKey] = useState<string | null>(null)
  const [expandedTables, setExpandedTables] = useState<Set<number>>(new Set())
  const [expandedRuns, setExpandedRuns] = useState<Set<number>>(new Set())
  const [acked, setAcked] = useState<Set<string>>(new Set())

  const scrollRef = useRef<HTMLDivElement>(null)
  const headingEls = useRef<Map<number, HTMLElement>>(new Map())
  const paraEls = useRef<Map<number, HTMLElement>>(new Map())

  // ---- 段落标记聚合（命中项 → 段落；同段多项合并不叠底色）----
  const paraMarkers = useMemo(() => {
    const m = new Map<number, Marker[]>()
    for (const it of result.items) {
      for (const h of it.hits) {
        if (h.paragraphIndex == null) continue
        const arr = m.get(h.paragraphIndex) ?? []
        arr.push({ code: it.code, severity: it.severity, itemTitle: it.title, key: `${it.code}#${h.paragraphIndex}` })
        m.set(h.paragraphIndex, arr)
      }
    }
    return m
  }, [result.items])

  // 每段最严重级别（决定底色）+ 合并角标 codes
  const paraWorst = useMemo(() => {
    const w = new Map<number, Severity>()
    paraMarkers.forEach((markers, pi) => {
      let worst: Severity = "info"
      for (const mk of markers) if (SEV_RANK[mk.severity] < SEV_RANK[worst]) worst = mk.severity
      w.set(pi, worst)
    })
    return w
  }, [paraMarkers])

  // ---- 章节问题数（左栏徽标）----
  const chapterIssues = useMemo(() => {
    const arr = chapters.map(() => ({ total: 0, critical: 0 }))
    for (const it of result.items) {
      for (const h of it.hits) {
        if (h.chapterIndex == null) continue
        const c = arr[h.chapterIndex]
        if (!c) continue
        c.total += 1
        if (it.severity === "critical") c.critical += 1
      }
    }
    return arr
  }, [result.items, chapters])

  // ---- 右栏问题条目（按级别过滤；含命中项，未定位命中仍展示但不可跳转）----
  const entries = useMemo(() => {
    const list: { item: CheckItem; hit: CheckHit; key: string; first: boolean }[] = []
    for (const it of result.items) {
      if (it.status !== "fail" && it.status !== "warn") continue
      if (sevFilter !== "all" && it.severity !== sevFilter) continue
      it.hits.forEach((h, i) => list.push({ item: it, hit: h, key: hitKey(it.code, h, i), first: i === 0 }))
    }
    list.sort((a, b) => SEV_RANK[a.item.severity] - SEV_RANK[b.item.severity])
    return list
  }, [result.items, sevFilter])

  // ---- 中栏块（表格整块折叠 / 正文段）----
  const blocks = useMemo<Block[]>(() => {
    const out: Block[] = []
    let i = 0
    while (i < paras.length) {
      const p = paras[i]
      if (p.inTable) {
        const ti = p.tableIndex ?? 0
        const pis: number[] = []
        while (i < paras.length && paras[i].inTable && (paras[i].tableIndex ?? 0) === ti) {
          pis.push(paras[i].index)
          i += 1
        }
        out.push({ t: "table", ti, pis })
      } else {
        out.push({ t: "para", pi: p.index })
        i += 1
      }
    }
    return out
  }, [paras])

  const blockHasIssue = useCallback(
    (b: Block): boolean => (b.t === "para" ? paraMarkers.has(b.pi) : b.pis.some((pi) => paraMarkers.has(pi))),
    [paraMarkers],
  )

  // 「只看有问题」：无问题块折叠成可展开灰条
  type Seg = { kind: "single"; block: Block } | { kind: "run"; blocks: Block[] }
  const segs = useMemo<Seg[]>(() => {
    if (!onlyIssues) return blocks.map((b) => ({ kind: "single" as const, block: b }))
    const out: Seg[] = []
    let run: Block[] = []
    const flush = () => {
      if (run.length) {
        out.push({ kind: "run", blocks: run })
        run = []
      }
    }
    for (const b of blocks) {
      if (blockHasIssue(b)) {
        flush()
        out.push({ kind: "single", block: b })
      } else {
        run.push(b)
      }
    }
    flush()
    return out
  }, [blocks, onlyIssues, blockHasIssue])

  // ---- 中栏滚动 → 左栏联动高亮 ----
  const recomputeActiveChapter = useCallback(() => {
    const c = scrollRef.current
    if (!c) return
    const line = c.getBoundingClientRect().top + 96
    let cur = 0
    headingEls.current.forEach((el, ci) => {
      if (el.getBoundingClientRect().top <= line && ci >= cur) cur = ci
    })
    setActiveChapter(cur)
  }, [])

  useEffect(() => {
    const c = scrollRef.current
    if (!c) return
    let raf = 0
    const onScroll = () => {
      cancelAnimationFrame(raf)
      raf = requestAnimationFrame(recomputeActiveChapter)
    }
    c.addEventListener("scroll", onScroll, { passive: true })
    recomputeActiveChapter()
    return () => {
      c.removeEventListener("scroll", onScroll)
      cancelAnimationFrame(raf)
    }
  }, [recomputeActiveChapter])

  // ---- 跳转 ----
  const goToChapter = useCallback((ci: number) => {
    const el = headingEls.current.get(ci)
    el?.scrollIntoView({ behavior: "smooth", block: "start" })
    setActiveChapter(ci)
  }, [])

  const locatePara = useCallback((pi: number | undefined, key: string) => {
    setSelectedKey(key)
    if (pi == null) return
    const el = paraEls.current.get(pi)
    el?.scrollIntoView({ behavior: "smooth", block: "center" })
    setFocusPara(pi)
    setFlashPara(pi)
    window.setTimeout(() => setFlashPara((p) => (p === pi ? null : p)), 1000)
  }, [])

  // ---- 左栏键盘 ↑↓ Enter ----
  const onNavKeyDown = useCallback(
    (e: ReactKeyboardEvent) => {
      if (e.key !== "ArrowDown" && e.key !== "ArrowUp" && e.key !== "Enter") return
      e.preventDefault()
      const max = chapters.length - 1
      if (e.key === "Enter") return goToChapter(activeChapter)
      const next = e.key === "ArrowDown" ? Math.min(max, activeChapter + 1) : Math.max(0, activeChapter - 1)
      goToChapter(next)
    },
    [activeChapter, chapters.length, goToChapter],
  )

  const toggleTable = (ti: number) =>
    setExpandedTables((prev) => {
      const n = new Set(prev)
      if (n.has(ti)) n.delete(ti)
      else n.add(ti)
      return n
    })

  const toggleRun = (startPi: number) =>
    setExpandedRuns((prev) => {
      const n = new Set(prev)
      if (n.has(startPi)) n.delete(startPi)
      else n.add(startPi)
      return n
    })

  const toggleAck = (key: string) =>
    setAcked((prev) => {
      const n = new Set(prev)
      if (n.has(key)) n.delete(key)
      else n.add(key)
      return n
    })

  const s = result.summary
  const pageCount = estimatePages(paras.map((p) => p.text).join(""))
  const shownChapters = sevFilter === "critical" ? chapters.map((c, ci) => ({ c, ci })).filter(({ ci }) => chapterIssues[ci].critical > 0) : chapters.map((c, ci) => ({ c, ci }))

  return (
    <div className="flex flex-col gap-3">
      {/* ---------- 顶部汇总条（点击筛选右栏 + 联动左栏 #6）---------- */}
      <div className="flex flex-wrap items-center justify-between gap-2">
        <div className="flex flex-wrap items-center gap-2 text-sm">
          {(["critical", "high", "medium", "info"] as Severity[]).map((sv) => (
            <button
              key={sv}
              onClick={() => setSevFilter((f) => (f === sv ? "all" : sv))}
              className={cn(
                "rounded-full border px-2.5 py-0.5 text-xs transition-colors",
                sevFilter === sv ? "border-primary bg-primary/10 text-primary" : "hover:bg-accent",
                s.bySeverity[sv] === 0 && "opacity-60",
              )}
            >
              {SEVERITY_LABEL[sv]} <b>{s.bySeverity[sv]}</b>
            </button>
          ))}
          {sevFilter !== "all" ? (
            <button className="text-xs text-muted-foreground hover:text-foreground" onClick={() => setSevFilter("all")}>
              清除筛选
            </button>
          ) : null}
        </div>
        <div className="flex items-center gap-2">
          {blocked ? (
            <span className={cn("text-xs", hardFatal ? "text-destructive" : "text-amber-600")}>
              {hardFatal ? "存在必改项，导出已禁用" : "存在必改项，导出将需二次确认"}
            </span>
          ) : (
            <span className="flex items-center gap-1 text-xs text-primary">
              <CheckCircle2 className="h-3.5 w-3.5" /> 可直接导出
            </span>
          )}
          <Button variant="outline" size="sm" onClick={onExportExcel} disabled={hardFatal}>
            <Table2 className="h-4 w-4" /> Excel
          </Button>
          <Button variant="outline" size="sm" onClick={onExportHtml} disabled={hardFatal}>
            <FileCode2 className="h-4 w-4" /> HTML
          </Button>
        </div>
      </div>

      {/* ---------- 三栏 ---------- */}
      <div className="flex gap-3" style={{ height: "calc(100vh - 250px)", minHeight: 460 }}>
        {/* 左栏：章节导航 */}
        <nav
          tabIndex={0}
          onKeyDown={onNavKeyDown}
          className="flex w-64 shrink-0 flex-col rounded-lg border bg-background outline-none focus:ring-2 focus:ring-primary/40"
          aria-label="章节导航"
        >
          <div className="flex items-center gap-1.5 border-b px-3 py-2 text-xs font-medium text-muted-foreground">
            <PanelLeft className="h-3.5 w-3.5" /> 章节导航
            <span className="ml-auto">共 {chapters.length} 章</span>
          </div>
          <div className="flex-1 overflow-y-auto p-1.5">
            {shownChapters.map(({ c, ci }) => {
              const iss = chapterIssues[ci]
              return (
                <button
                  key={ci}
                  onClick={() => goToChapter(ci)}
                  className={cn(
                    "flex w-full items-start gap-1.5 rounded-md px-2 py-1.5 text-left text-sm",
                    activeChapter === ci ? "bg-primary/10 text-primary" : "hover:bg-accent",
                  )}
                >
                  <span className="mt-0.5 line-clamp-2 flex-1">{c.title || "（无题）"}</span>
                  {iss.total > 0 ? (
                    <span
                      className={cn(
                        "mt-0.5 shrink-0 rounded-full px-1.5 py-0.5 text-[10px] font-medium",
                        iss.critical > 0 ? "bg-red-500 text-white" : "bg-amber-100 text-amber-800",
                      )}
                    >
                      {iss.total}
                    </span>
                  ) : null}
                </button>
              )
            })}
            {shownChapters.length === 0 ? (
              <div className="px-2 py-6 text-center text-xs text-muted-foreground">当前筛选下无匹配章节</div>
            ) : null}
          </div>
        </nav>

        {/* 中栏：只读正文 */}
        <section className="flex min-w-0 flex-1 flex-col rounded-lg border bg-background">
          <div className="flex items-center justify-between gap-2 border-b px-3 py-2 text-xs">
            <div className="inline-flex overflow-hidden rounded-md border">
              <button
                className={cn("px-2.5 py-1", !onlyIssues ? "bg-primary text-primary-foreground" : "bg-background hover:bg-accent")}
                onClick={() => setOnlyIssues(false)}
              >
                <Eye className="mr-1 inline h-3.5 w-3.5" /> 显示全部
              </button>
              <button
                className={cn("px-2.5 py-1", onlyIssues ? "bg-primary text-primary-foreground" : "bg-background hover:bg-accent")}
                onClick={() => setOnlyIssues(true)}
              >
                <EyeOff className="mr-1 inline h-3.5 w-3.5" /> 只看有问题
              </button>
            </div>
            <span className="text-muted-foreground">
              段落 {paras.length} · 章节 {chapters.length} · 页数≈{pageCount}
            </span>
          </div>
          <div ref={scrollRef} className="flex-1 overflow-y-auto px-6 py-4">
            {/* A4 版心 */}
            <div className="mx-auto max-w-[794px]">
              {segs.map((seg, si) => {
                if (seg.kind === "run") {
                  const startPi = seg.blocks[0] && seg.blocks[0].t === "para" ? (seg.blocks[0] as { pi: number }).pi : si
                  const open = expandedRuns.has(startPi)
                  const count = seg.blocks.reduce((n, b) => n + (b.t === "para" ? 1 : b.pis.length), 0)
                  if (!open) {
                    return (
                      <button
                        key={`run-${si}`}
                        onClick={() => toggleRun(startPi)}
                        className="my-1 flex w-full items-center gap-1.5 rounded bg-muted/50 px-3 py-1 text-xs text-muted-foreground hover:bg-muted"
                      >
                        <ChevronRight className="h-3.5 w-3.5" /> 连续 {count} 段无问题（点击展开）
                      </button>
                    )
                  }
                  return (
                    <div key={`run-${si}`}>
                      <button onClick={() => toggleRun(startPi)} className="my-1 flex w-full items-center gap-1.5 rounded bg-muted/50 px-3 py-1 text-xs text-muted-foreground hover:bg-muted">
                        <ChevronDown className="h-3.5 w-3.5" /> 连续 {count} 段无问题（点击折叠）
                      </button>
                      {seg.blocks.map((b) => (
                        <BlockRow key={blkKey(b)} b={b} {...{ paras, chapterOf, paraMarkers, paraWorst, flashPara, focusPara, headingEls, paraEls, expandedTables, setHoverPara, toggleTable }} />
                      ))}
                    </div>
                  )
                }
                const b = seg.block
                return <BlockRow key={blkKey(b)} b={b} {...{ paras, chapterOf, paraMarkers, paraWorst, flashPara, focusPara, headingEls, paraEls, expandedTables, setHoverPara, toggleTable }} />
              })}
              {paras.length === 0 ? <div className="py-10 text-center text-sm text-muted-foreground">无可渲染正文（项目未填章节或文件无正文）</div> : null}
            </div>
          </div>
        </section>

        {/* 右栏：问题清单 */}
        <aside className="flex w-80 shrink-0 flex-col rounded-lg border bg-background">
          <div className="flex items-center gap-1.5 border-b px-3 py-2 text-xs font-medium text-muted-foreground">
            <ListChecks className="h-3.5 w-3.5" /> 问题清单
            <span className="ml-auto">{entries.length} 处</span>
          </div>
          <div className="flex-1 space-y-2 overflow-y-auto p-2">
            {entries.map(({ item, hit, key, first }) => {
              const active = selectedKey === key
              const hovered = hit.paragraphIndex != null && hoverPara === hit.paragraphIndex
              const isAcked = acked.has(key)
              return (
                <div
                  key={key}
                  className={cn(
                    "rounded-md border px-2.5 py-2 text-sm transition-colors",
                    active ? "border-primary bg-primary/5" : hovered ? "border-primary/50 bg-accent/60" : "hover:bg-accent/40",
                    isAcked && "opacity-60",
                  )}
                >
                  {first ? (
                    <div className="mb-1 flex items-center gap-1.5">
                      <span className="w-14 shrink-0 font-mono text-[11px] text-muted-foreground">{item.code}</span>
                      <span className="flex-1 truncate text-xs font-medium">{item.title}</span>
                      <Badge variant={item.severity === "critical" ? "danger" : item.severity === "info" ? "neutral" : "warning"}>{SEVERITY_LABEL[item.severity]}</Badge>
                    </div>
                  ) : null}
                  <div className="text-[11px] text-muted-foreground">
                    {[hit.chapterTitle, hit.sectionHint, hit.lineNo != null ? `第 ${hit.lineNo} 段` : null, hit.paragraphIndex == null ? hit.location : null]
                      .filter(Boolean)
                      .join(" / ") || hit.location}
                  </div>
                  <div className="mt-0.5 line-clamp-3 text-xs">{hit.paragraphText || hit.text}</div>
                  {hit.paragraphIndex != null ? (
                    <div className="mt-1.5 flex items-center gap-1.5">
                      <Button size="sm" variant="outline" className="h-6 px-2 text-xs" onClick={() => locatePara(hit.paragraphIndex, key)}>
                        定位
                      </Button>
                      <Button size="sm" variant="ghost" className="h-6 px-2 text-xs" onClick={() => toggleAck(key)}>
                        {isAcked ? "已标记" : "标记已改"}
                      </Button>
                      <span className="ml-auto text-[10px] text-muted-foreground">手动调整（本工具不改正文）</span>
                    </div>
                  ) : (
                    <div className="mt-1.5 text-[10px] text-muted-foreground">元数据/结构类命中，无正文定位</div>
                  )}
                </div>
              )
            })}
            {entries.length === 0 ? (
              <div className="px-2 py-8 text-center text-xs text-muted-foreground">
                {sevFilter !== "all" ? "当前级别下无问题" : "未发现问题（或均已通过）"}
              </div>
            ) : null}
          </div>
        </aside>
      </div>

      {blocked && !hardFatal ? (
        <div className="flex items-center gap-2 rounded-md border border-destructive/30 bg-destructive/5 px-3 py-2 text-xs text-destructive">
          <ShieldAlert className="h-4 w-4" /> 暗标存在 {s.fail} 项必改；导出清单用于分工需二次确认。请优先在 Word 中整改。
        </div>
      ) : null}
    </div>
  )
}

// ---- 块渲染 ---------------------------------------------------------------

function blkKey(b: Block): string {
  return b.t === "para" ? `p${b.pi}` : `t${b.ti}`
}

type BlockRowProps = {
  b: Block
  paras: BidCheckResult["paragraphs"]
  chapterOf: number[]
  paraMarkers: Map<number, Marker[]>
  paraWorst: Map<number, Severity>
  flashPara: number | null
  focusPara: number | null
  headingEls: MutableRefObject<Map<number, HTMLElement>>
  paraEls: MutableRefObject<Map<number, HTMLElement>>
  expandedTables: Set<number>
  setHoverPara: (pi: number | null) => void
  toggleTable: (ti: number) => void
}

function BlockRow(p: BlockRowProps) {
  const { b } = p
  if (b.t === "table") {
    const open = p.expandedTables.has(b.ti)
    const cells = b.pis.map((pi) => p.paras[pi]).filter(Boolean)
    const issues = b.pis.filter((pi) => p.paraMarkers.has(pi)).length
    return (
      <div className="my-1.5">
        <button
          onClick={() => p.toggleTable(b.ti)}
          className={cn("flex w-full items-center gap-2 rounded border border-dashed bg-muted/40 px-3 py-1.5 text-xs text-muted-foreground hover:bg-muted", issues > 0 && "border-red-300")}
        >
          {open ? <ChevronDown className="h-3.5 w-3.5" /> : <ChevronRight className="h-3.5 w-3.5" />}
          <Table2 className="h-3.5 w-3.5" /> 表格（含 {b.pis.length} 段）
          {issues > 0 ? <span className="ml-auto text-red-500">{issues} 处问题</span> : null}
        </button>
        {open ? (
          <ul className="mt-1 space-y-0.5 border-l border-dashed pl-4 text-xs text-muted-foreground">
            {cells.map((c) => (
              <li key={c.index} className="truncate">
                {c.text || "（空单元格）"}
              </li>
            ))}
          </ul>
        ) : null}
      </div>
    )
  }

  const para = p.paras[b.pi]
  if (!para) return null
  const markers = p.paraMarkers.get(b.pi)
  const worst = p.paraWorst.get(b.pi)
  const isHeading = para.heading
  const level = isHeading ? headingLevel(para.text) : 4
  const ci = p.chapterOf[b.pi] ?? 0

  return (
    <div
      ref={(el) => {
        if (el) {
          p.paraEls.current.set(b.pi, el)
          if (isHeading) p.headingEls.current.set(ci, el)
        }
      }}
      onMouseEnter={() => (markers && markers.length > 0 ? p.setHoverPara(b.pi) : undefined)}
      onMouseLeave={() => p.setHoverPara(null)}
      className={cn(
        "relative scroll-mt-24",
        isHeading ? HEADING_CLS[level] : "text-sm leading-[1.8] indent-8",
        worst && SEV_BG[worst],
        "px-2 py-0.5 transition-all",
        p.flashPara === b.pi && "ring-2 ring-primary ring-offset-1 animate-pulse",
        p.focusPara === b.pi && !markers && "ring-1 ring-primary/40",
      )}
      title={markers ? markers.map((m) => `${m.code} ${m.itemTitle}`).join("\n") : undefined}
    >
      {markers && markers.length > 0 ? (
        <span className={cn("absolute -top-2 right-1 z-10 rounded px-1.5 py-0.5 text-[10px] font-medium shadow-sm", SEV_BADGE[worst ?? "info"].cls)}>
          {markers.length > 1 ? `${SEV_BADGE[worst ?? "info"].label} ×${markers.length}` : SEV_BADGE[worst ?? "info"].label}
          <span className="ml-1 font-mono opacity-80">{markers.map((m) => m.code).join("+")}</span>
        </span>
      ) : null}
      {para.hasImage ? (
        <span className="mr-1 inline-flex items-center gap-0.5 rounded bg-slate-100 px-1 py-0.5 align-middle text-[10px] text-slate-500">
          <ImageIcon className="h-3 w-3" /> 图片
        </span>
      ) : null}
      <span className={cn(isHeading ? "" : "text-foreground")}>{para.text}</span>
    </div>
  )
}
