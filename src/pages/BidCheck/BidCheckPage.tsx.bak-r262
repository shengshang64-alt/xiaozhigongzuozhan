// ---------------------------------------------------------------------------
// BidCheckPage —— 标书检查中枢页面（与 7 步流水线平级的独立入口 /bid-check）。
//
// 一个开关切「普通 / 暗标严格」；两路输入（上传 docx/pdf 或选择标书项目）；
// 五级清单 + 分级筛选 + 逐条五要素；导出三件套（清单页 / Excel / HTML）；暗标门禁。
// ⚠️ 只标不改：页面呈现的是覆盖层结论，不提供任何改正文的入口。
// ---------------------------------------------------------------------------

import { useMemo, useRef, useState } from "react"
import {
  ClipboardCheck,
  Upload,
  FileText,
  Table2,
  FileCode2,
  ShieldAlert,
  Settings2,
  Loader2,
  CheckCircle2,
  X,
} from "lucide-react"
import { cn } from "@/lib/utils"
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card"
import { Button } from "@/components/ui/button"
import { Badge } from "@/components/ui/badge"
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogDescription,
  DialogFooter,
} from "@/components/ui/dialog"
import {
  CHECK_LEVEL_LABEL,
  ITEM_STATUS_LABEL,
  SEVERITY_DOT,
  SEVERITY_LABEL,
  SEVERITY_BADGE_VARIANT,
  hasBlockingCritical,
  type BidCheckResult,
  type CheckItem,
  type CheckLevel,
  type Severity,
} from "./bidCheckTypes"
import { exportChecklistToExcel } from "./report/toExcel"
import { exportHtmlReport } from "./report/toHtml"
import { BidCheckConfigDialog } from "./BidCheckConfigDialog"
import type { BidCheckVm } from "./useBidCheck"

const LEVELS: CheckLevel[] = ["L1", "L2", "L3", "L4", "L5"]

const STATUS_BADGE: Record<CheckItem["status"], "success" | "danger" | "warning" | "neutral"> = {
  pass: "success",
  fail: "danger",
  warn: "warning",
  unconfigured: "neutral",
  skipped: "neutral",
}

export function BidCheckPage(vm: BidCheckVm) {
  const {
    mode,
    setMode,
    source,
    sourceLabel,
    pickFile,
    pickProject,
    clearSource,
    running,
    result,
    run,
    projects,
    projectsLoading,
    anbidCfg,
  } = vm

  const fileInputRef = useRef<HTMLInputElement>(null)
  const [showConfig, setShowConfig] = useState(false)
  const [onlyIssues, setOnlyIssues] = useState(true)
  const [levelFilter, setLevelFilter] = useState<CheckLevel | "all">("all")
  const [sevFilter, setSevFilter] = useState<Severity | "all">("all")
  const [gateOpen, setGateOpen] = useState(false)
  const [pendingExport, setPendingExport] = useState<null | "excel" | "html">(null)

  const sealed = mode === "sealed"
  const blocked = !!result && sealed && hasBlockingCritical(result)
  const hardFatal = blocked && anbidCfg.sealedViolationIsFatal

  const doExport = (kind: "excel" | "html") => {
    if (!result) return
    if (kind === "excel") {
      exportChecklistToExcel(result)
      return
    }
    exportHtmlReport(result)
  }

  const tryExport = (kind: "excel" | "html") => {
    if (!result) return
    if (hardFatal) return
    if (blocked) {
      setPendingExport(kind)
      setGateOpen(true)
      return
    }
    doExport(kind)
  }

  return (
    <div className="mx-auto max-w-6xl space-y-4 p-4 sm:p-6">
      {/* ---------- 顶部：标题 + 模式开关 ---------- */}
      <div className="flex flex-wrap items-center justify-between gap-3">
        <div className="flex items-center gap-2">
          <ClipboardCheck className="h-6 w-6 text-primary" />
          <div>
            <h1 className="text-xl font-semibold">标书检查中枢</h1>
            <p className="text-xs text-muted-foreground">纯规则 · 零 AI · 只标不改（不改正文，产出清单 / Excel / HTML 覆盖层）</p>
          </div>
        </div>
        <div className="flex items-center gap-2">
          <div className="inline-flex overflow-hidden rounded-md border">
            <button
              className={cn("px-3 py-1.5 text-sm", !sealed ? "bg-primary text-primary-foreground" : "bg-background hover:bg-accent")}
              onClick={() => setMode("normal")}
            >
              普通模式
            </button>
            <button
              className={cn("px-3 py-1.5 text-sm", sealed ? "bg-destructive text-destructive-foreground" : "bg-background hover:bg-accent")}
              onClick={() => setMode("sealed")}
            >
              暗标严格模式
            </button>
          </div>
          <Button variant="outline" size="sm" onClick={() => setShowConfig(true)}>
            <Settings2 className="h-4 w-4" /> 配置
          </Button>
        </div>
      </div>

      {sealed ? (
        <div className="flex items-center gap-2 rounded-md border border-destructive/30 bg-destructive/5 px-3 py-2 text-sm text-destructive">
          <ShieldAlert className="h-4 w-4" /> 暗标严格模式：L1~L5 全开，加严阈值，检出身份泄露 / 元数据痕迹将触发导出门禁。
        </div>
      ) : null}

      {/* ---------- 输入区 ---------- */}
      <Card>
        <CardHeader className="pb-3">
          <CardTitle className="text-sm">检查对象</CardTitle>
        </CardHeader>
        <CardContent className="space-y-3">
          <div className="grid gap-3 sm:grid-cols-2">
            <div className="space-y-2 rounded-md border p-3">
              <div className="text-sm font-medium">上传文件</div>
              <p className="text-xs text-muted-foreground">.docx 走全量（含元数据 / 节点痕迹）；.pdf 走正文 + PDF 元数据。</p>
              <input
                ref={fileInputRef}
                type="file"
                accept=".docx,.pdf"
                className="hidden"
                onChange={(e) => {
                  const f = e.target.files?.[0]
                  if (f) pickFile(f)
                  e.target.value = ""
                }}
              />
              <Button variant="secondary" size="sm" onClick={() => fileInputRef.current?.click()}>
                <Upload className="h-4 w-4" /> 选择 docx / pdf
              </Button>
            </div>
            <div className="space-y-2 rounded-md border p-3">
              <div className="text-sm font-medium">选择标书项目</div>
              <p className="text-xs text-muted-foreground">复用项目正文做检查（无文件包，节点痕迹项标「无法检测」）。</p>
              <select
                className="h-9 w-full rounded-md border border-input bg-background px-2 text-sm disabled:opacity-60"
                value={source.kind === "project" ? source.record.id : ""}
                disabled={projectsLoading || projects.length === 0}
                onChange={(e) => pickProject(e.target.value)}
              >
                <option value="">{projectsLoading ? "加载中…" : projects.length ? "请选择项目" : "暂无项目"}</option>
                {projects.map((p) => (
                  <option key={p.id} value={p.id}>
                    {p.project_name || p.id}
                  </option>
                ))}
              </select>
            </div>
          </div>
          <div className="flex items-center justify-between gap-2">
            <div className="flex items-center gap-2 text-sm">
              {source.kind === "none" ? (
                <span className="text-muted-foreground">尚未选择检查对象</span>
              ) : (
                <>
                  <FileText className="h-4 w-4 text-primary" />
                  <span className="font-medium">{sourceLabel}</span>
                  <Badge variant="neutral">{source.kind === "file" ? "上传文件" : "项目正文"}</Badge>
                  <button className="text-xs text-muted-foreground hover:text-foreground" onClick={clearSource}>
                    <X className="inline h-3 w-3" /> 清除
                  </button>
                </>
              )}
            </div>
            <Button onClick={run} disabled={running || source.kind === "none"}>
              {running ? <Loader2 className="h-4 w-4 animate-spin" /> : <ClipboardCheck className="h-4 w-4" />}
              开始检查
            </Button>
          </div>
        </CardContent>
      </Card>

      {/* ---------- 结果区 ---------- */}
      {result ? (
        <ResultView
          result={result}
          onlyIssues={onlyIssues}
          setOnlyIssues={setOnlyIssues}
          levelFilter={levelFilter}
          setLevelFilter={setLevelFilter}
          sevFilter={sevFilter}
          setSevFilter={setSevFilter}
          blocked={blocked}
          hardFatal={hardFatal}
          onExportExcel={() => tryExport("excel")}
          onExportHtml={() => tryExport("html")}
        />
      ) : (
        <Card>
          <CardContent className="py-10 text-center text-sm text-muted-foreground">
            {source.kind === "none" ? "上传文件或选择项目后点击「开始检查」" : "点击「开始检查」生成五级检查清单"}
          </CardContent>
        </Card>
      )}

      {/* ---------- 配置弹窗 ---------- */}
      <BidCheckConfigDialog
        open={showConfig}
        onClose={() => setShowConfig(false)}
        anbid={vm.anbidCfg}
        checkCfg={vm.checkCfg}
        onSaveAnbid={vm.patchAnbidCfg}
        onSaveCheck={vm.patchCheckCfg}
      />

      {/* ---------- 暗标导出门禁：二次确认可继续 ---------- */}
      <Dialog open={gateOpen} onOpenChange={(o) => (o ? undefined : setGateOpen(false))}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle className="flex items-center gap-2 text-destructive">
              <ShieldAlert className="h-5 w-5" /> 暗标存在必改项
            </DialogTitle>
            <DialogDescription>
              当前检出 <b>{result?.summary.fail ?? 0}</b> 项必须整改（含废标级 🔴）。建议先按清单在 Word 中整改再导出。
              如需先行导出清单用于分工，可在二次确认后继续。
            </DialogDescription>
          </DialogHeader>
          <DialogFooter>
            <Button variant="outline" onClick={() => setGateOpen(false)}>
              返回整改
            </Button>
            <Button
              variant="destructive"
              onClick={() => {
                if (pendingExport) doExport(pendingExport)
                setGateOpen(false)
              }}
            >
              确认仍要导出
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  )
}

// ---------------------------------------------------------------------------
// 结果视图（汇总 + 筛选 + 分级清单）
// ---------------------------------------------------------------------------

type ResultViewProps = {
  result: BidCheckResult
  onlyIssues: boolean
  setOnlyIssues: (v: boolean) => void
  levelFilter: CheckLevel | "all"
  setLevelFilter: (v: CheckLevel | "all") => void
  sevFilter: Severity | "all"
  setSevFilter: (v: Severity | "all") => void
  blocked: boolean
  hardFatal: boolean
  onExportExcel: () => void
  onExportHtml: () => void
}

function ResultView(p: ResultViewProps) {
  const { result } = p
  const s = result.summary
  const presentLevels = LEVELS.filter((lv) => result.items.some((it) => it.level === lv))

  const filtered = useMemo(
    () =>
      result.items.filter((it) => {
        if (p.levelFilter !== "all" && it.level !== p.levelFilter) return false
        if (p.sevFilter !== "all" && it.severity !== p.sevFilter) return false
        if (p.onlyIssues && it.status === "pass") return false
        return true
      }),
    [result.items, p.levelFilter, p.sevFilter, p.onlyIssues],
  )

  return (
    <div className="space-y-4">
      {/* 汇总卡 */}
      <div className="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <Stat label="检查项" value={s.total} />
        <Stat label="命中必改" value={s.fail} tone={s.fail ? "bad" : "ok"} />
        <Stat label="命中建议" value={s.warn} tone={s.warn ? "warn" : "ok"} />
        <Stat label="未配置/无法检测" value={s.unconfigured + s.skipped} tone="muted" />
      </div>

      {/* 导出条 */}
      <Card>
        <CardContent className="flex flex-wrap items-center justify-between gap-3 py-4">
          <div className="flex flex-wrap items-center gap-3 text-sm">
            {(["critical", "high", "medium", "info"] as Severity[]).map((sv) => (
              <span key={sv} className="flex items-center gap-1">
                <span>{SEVERITY_DOT[sv]}</span>
                {SEVERITY_LABEL[sv]}
                <b>{s.bySeverity[sv]}</b>
              </span>
            ))}
          </div>
          <div className="flex items-center gap-2">
            {p.blocked ? (
              <span className={cn("text-xs", p.hardFatal ? "text-destructive" : "text-warning")}>
                {p.hardFatal ? "暗标存在必改项，导出已禁用（配置声明违规即废标）" : "存在必改项，导出将需二次确认"}
              </span>
            ) : (
              <span className="flex items-center gap-1 text-xs text-primary">
                <CheckCircle2 className="h-3.5 w-3.5" /> 可直接导出
              </span>
            )}
            <Button variant="outline" size="sm" onClick={p.onExportExcel} disabled={p.hardFatal}>
              <Table2 className="h-4 w-4" /> 整改清单 Excel
            </Button>
            <Button variant="outline" size="sm" onClick={p.onExportHtml} disabled={p.hardFatal}>
              <FileCode2 className="h-4 w-4" /> 体检报告 HTML
            </Button>
          </div>
        </CardContent>
      </Card>

      {/* 筛选条 */}
      <div className="flex flex-wrap items-center gap-2 text-sm">
        <select
          className="h-8 rounded-md border border-input bg-background px-2"
          value={p.levelFilter}
          onChange={(e) => p.setLevelFilter(e.target.value as CheckLevel | "all")}
        >
          <option value="all">全部层级</option>
          {presentLevels.map((lv) => (
            <option key={lv} value={lv}>
              {CHECK_LEVEL_LABEL[lv]}
            </option>
          ))}
        </select>
        <select
          className="h-8 rounded-md border border-input bg-background px-2"
          value={p.sevFilter}
          onChange={(e) => p.setSevFilter(e.target.value as Severity | "all")}
        >
          <option value="all">全部级别</option>
          <option value="critical">必须整改</option>
          <option value="high">丢分风险</option>
          <option value="medium">建议整改</option>
          <option value="info">提示</option>
        </select>
        <label className="flex items-center gap-1.5">
          <input type="checkbox" checked={p.onlyIssues} onChange={(e) => p.setOnlyIssues(e.target.checked)} /> 只看有问题项
        </label>
        <span className="text-xs text-muted-foreground">（共 {result.items.length} 项，当前 {filtered.length} 项）</span>
      </div>

      {/* 清单 */}
      {presentLevels.map((lv) => {
        const rows = filtered.filter((it) => it.level === lv)
        if (!rows.length) return null
        return (
          <Card key={lv}>
            <CardHeader className="pb-2">
              <CardTitle className="text-sm">{CHECK_LEVEL_LABEL[lv]}</CardTitle>
            </CardHeader>
            <CardContent className="space-y-2">
              {rows.map((it) => (
                <ItemRow key={`${it.level}-${it.code}`} item={it} />
              ))}
            </CardContent>
          </Card>
        )
      })}
      {filtered.length === 0 ? (
        <Card>
          <CardContent className="py-8 text-center text-sm text-muted-foreground">
            {p.onlyIssues ? "当前筛选下无问题项（可取消「只看有问题项」查看全部检查）" : "无匹配项"}
          </CardContent>
        </Card>
      ) : null}
    </div>
  )
}

function Stat({ label, value, tone = "default" }: { label: string; value: number; tone?: "default" | "ok" | "warn" | "bad" | "muted" }) {
  const toneCls =
    tone === "bad" ? "text-destructive" : tone === "warn" ? "text-warning" : tone === "ok" ? "text-primary" : tone === "muted" ? "text-muted-foreground" : "text-foreground"
  return (
    <Card>
      <CardContent className="py-3">
        <div className={cn("text-2xl font-semibold", toneCls)}>{value}</div>
        <div className="text-xs text-muted-foreground">{label}</div>
      </CardContent>
    </Card>
  )
}

function ItemRow({ item }: { item: CheckItem }) {
  const [open, setOpen] = useState(item.status === "fail" || item.status === "warn")
  const hasHits = item.hits.length > 0
  return (
    <div className="rounded-md border">
      <button className="flex w-full items-center gap-2 px-3 py-2 text-left text-sm" onClick={() => setOpen((o) => !o)}>
        <span className="w-14 shrink-0 font-mono text-xs text-muted-foreground">{item.code}</span>
        <span className="shrink-0">{SEVERITY_DOT[item.severity]}</span>
        <span className="flex-1 truncate">{item.title}</span>
        <Badge variant="neutral" className="hidden shrink-0 sm:inline-flex">
          {item.category}
        </Badge>
        <Badge variant={SEVERITY_BADGE_VARIANT[item.severity]}>{SEVERITY_LABEL[item.severity]}</Badge>
        <Badge variant={STATUS_BADGE[item.status]}>{ITEM_STATUS_LABEL[item.status]}</Badge>
        {hasHits ? <span className="shrink-0 text-xs text-muted-foreground">{item.hits.length}处</span> : null}
      </button>
      {open ? (
        <div className="space-y-2 border-t px-3 py-2 text-sm">
          <div>
            <span className="text-muted-foreground">依据：</span>
            {item.basis}
          </div>
          <div>
            <span className="text-muted-foreground">建议：</span>
            <span className="text-primary">{item.suggestion}</span>
          </div>
          {hasHits ? (
            <ul className="space-y-1">
              {item.hits.map((h, i) => (
                <li key={i} className="rounded bg-muted/40 px-2 py-1">
                  <div className="text-xs font-medium text-muted-foreground">{h.location}</div>
                  <div>{h.text}</div>
                  {h.basis ? <div className="text-xs text-muted-foreground">（{h.basis}）</div> : null}
                </li>
              ))}
            </ul>
          ) : (
            <div className="text-xs text-muted-foreground">
              {item.status === "unconfigured" ? "标准未配置，不判定" : item.status === "skipped" ? "当前输入无法检测" : item.status === "pass" ? "未发现问题" : "无定位命中"}
            </div>
          )}
        </div>
      ) : null}
    </div>
  )
}
