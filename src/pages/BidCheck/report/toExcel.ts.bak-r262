// ---------------------------------------------------------------------------
// toExcel.ts —— 整改清单导出（xlsx）。零 AI 项置信度填「—」；责任人留空待分工。
//
// ⚠️ 只读产出：把检查结果铺成一张供人工逐条整改/分工的表，不触碰原文件。
// 一命中一行；pass 项不入表；unconfigured / skipped 各入一行提示（整改前须先补标准/换输入）。
// ---------------------------------------------------------------------------

import * as XLSX from "xlsx"
import { buildSafeFileName } from "@/lib/fileName"
import { triggerBlobDownload } from "@/lib/download"
import {
  CHECK_LEVEL_LABEL,
  ITEM_STATUS_LABEL,
  SEVERITY_LABEL,
  type BidCheckResult,
  type CheckItem,
} from "../bidCheckTypes"

const HEADERS = [
  "序号",
  "级别",
  "层级",
  "检查项编号",
  "检查项",
  "位置",
  "问题原文",
  "依据",
  "建议改法",
  "置信度",
  "责任人",
  "状态",
]

/** 展开为「一行一命中」的行数组（含表头）；无命中的 fail/warn 项也占一行（问题原文留空，位置=判定依据） */
function buildRows(result: BidCheckResult): (string | number)[][] {
  const aoa: (string | number)[][] = [HEADERS]
  let seq = 1
  for (const it of result.items) {
    if (it.status === "pass") continue
    const base = [
      seq,
      SEVERITY_LABEL[it.severity],
      CHECK_LEVEL_LABEL[it.level],
      it.code,
      it.title,
    ]
    const tail = [
      it.basis,
      it.suggestion,
      it.confidence == null ? "—" : `${Math.round(it.confidence * 100)}%`,
      "",
      ITEM_STATUS_LABEL[it.status],
    ]
    if (it.hits.length === 0) {
      aoa.push([...base, "（无定位命中）", "", ...tail])
      seq += 1
    } else {
      for (const h of it.hits) {
        aoa.push([...base, h.location, h.text, ...tail])
        seq += 1
      }
    }
  }
  return aoa
}

/** 汇总 sheet（五级通过/命中统计 + 严重度分布） */
function buildSummaryRows(result: BidCheckResult): (string | number)[][] {
  const s = result.summary
  const byLevel: Record<string, { total: number; issue: number }> = {}
  for (const it of result.items) {
    const g = (byLevel[it.level] ??= { total: 0, issue: 0 })
    g.total += 1
    if (it.status === "fail" || it.status === "warn") g.issue += 1
  }
  const rows: (string | number)[][] = [
    ["检查模式", result.mode === "sealed" ? "暗标严格模式" : "普通模式"],
    ["检查对象", result.sourceName],
    ["输入形态", result.inputKind === "file" ? "上传文件" : "选择项目"],
    ["是否含文件包", result.hasPackage ? "是（可检元数据/节点痕迹）" : "否（节点痕迹标为无法检测）"],
    ["生成时间", result.generatedAt],
    [],
    ["合计检查项", s.total, "通过", s.passed, "命中必改", s.fail, "命中建议", s.warn, "标准未配置", s.unconfigured, "无法检测", s.skipped],
    [],
    ["层级", "检查项数", "命中数"],
  ]
  for (const lv of ["L1", "L2", "L3", "L4", "L5"] as const) {
    const g = byLevel[lv]
    if (g) rows.push([CHECK_LEVEL_LABEL[lv], g.total, g.issue])
  }
  rows.push([])
  rows.push(["严重度分布（仅命中项）", "必须整改", s.bySeverity.critical, "丢分风险", s.bySeverity.high, "建议整改", s.bySeverity.medium, "提示", s.bySeverity.info])
  return rows
}

/** 生成整改清单工作簿 Blob（不触发下载，供测试与预览复用） */
export function buildExcelBlob(result: BidCheckResult): Blob {
  const wb = XLSX.utils.book_new()
  const ws = XLSX.utils.aoa_to_sheet(buildRows(result))
  ws["!cols"] = [
    { wch: 6 },
    { wch: 10 },
    { wch: 14 },
    { wch: 12 },
    { wch: 24 },
    { wch: 26 },
    { wch: 48 },
    { wch: 40 },
    { wch: 36 },
    { wch: 8 },
    { wch: 10 },
    { wch: 12 },
  ]
  XLSX.utils.book_append_sheet(wb, ws, "整改清单")

  const ss = XLSX.utils.aoa_to_sheet(buildSummaryRows(result))
  ss["!cols"] = [{ wch: 20 }, { wch: 16 }, { wch: 12 }, { wch: 12 }, { wch: 12 }, { wch: 12 }, { wch: 12 }, { wch: 12 }, { wch: 12 }, { wch: 12 }]
  XLSX.utils.book_append_sheet(wb, ss, "汇总")

  const buf = XLSX.write(wb, { type: "array", bookType: "xlsx" }) as ArrayBuffer
  return new Blob([buf], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" })
}

/** 导出并触发下载；返回写入的整改行数（命中口径，供 toast） */
export function exportChecklistToExcel(result: BidCheckResult, itemsWithIssue?: CheckItem[]): number {
  const blob = buildExcelBlob(result)
  const name = buildSafeFileName(`${result.sourceName}-检查整改清单`, "xlsx", "标书检查整改清单")
  triggerBlobDownload(blob, name)
  return (itemsWithIssue ?? result.items).filter((it) => it.status === "fail" || it.status === "warn").length
}
